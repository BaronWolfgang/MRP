install.packages("ComplexHeatmap")
library("ComplexHeatmap")
BiocManager::install("ComplexHeatmap")
library("ComplexHeatmap")
for (pdb_entry in unique(data_predictions_normalized$PDB)) {
data_predictions_normalised_subset <- data_predictions_normalized %>% na.omit() %>%
filter(PDB == pdb_entry)
proteinname <- unique(data_predictions_normalised_subset$proteinname)
for (chain_index in unique(data_predictions_normalised_subset$chain)) {
data_predictions_normalised_subset_wide <- data_predictions_normalised_subset %>%
filter(chain == chain_index) %>%
select(resno, `BepiPred-2.0 probability`, `BepiPred-3.0 score`,
`DiscoTope-3.0_calibrated_score`, Epigraph_score) %>%
distinct(resno, .keep_all = TRUE) %>%
column_to_rownames("resno") %>%
as.data.frame()
residues <- as.numeric(rownames(data_predictions_normalised_subset_wide))
colorbar_df <- get_residueindex_colors(residues, rev = FALSE)
annotation_col <- data.frame(NGL_Color = factor(residues))
rownames(annotation_col) <- residues
annotation_colors <- list(
NGL_Color = setNames(colorbar_df$color, residues)
)
# Create the ComplexHeatmap figure
figure <- Heatmap(
data_predictions_normalised_subset_wide,
name = "Scores",
row_names_side = "left",
cluster_rows = TRUE,
cluster_columns = FALSE,
show_column_names = TRUE,
show_row_names = TRUE,
column_names_gp = gpar(fontsize = 8),
row_names_gp = gpar(fontsize = 8),
top_annotation = NULL,
bottom_annotation = HeatmapAnnotation(
NGL_Color = anno_simple(residues, col = annotation_colors$NGL_Color)
),
heatmap_legend_param = list(title = "Scores"),
column_title = paste0(pdb_entry, " chain ", chain_index, " (", proteinname, ")"),
column_title_gp = gpar(fontsize = 12, fontface = "bold"),
show_heatmap_legend = TRUE
)
print(figure)
# Save the figure
ggsave(filename = paste0("output/figures/heatmap/", pdb_entry, "_", chain_index, "_heatmap.png"),
plot = figure,
width = 14, height = 10, dpi = 300,
bg = "white")
}
}
