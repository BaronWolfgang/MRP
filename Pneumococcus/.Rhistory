geom_hline(yintercept = log2(1), linetype = "dashed") +
geom_point() +
scale_x_continuous(limits = c(1, NA)) +
#geom_text_repel(
#  aes(label = protein),
#  size = 3,
#  max.overlaps = 30,       # adjust depending on clutter
#  box.padding = 0.4,
#  point.padding = 0.2,
#  segment.color = "grey70"
#) +
labs(
y = "log2(Odds Ratio)",
x = "Ranking"
) +
scale_color_discrete(name = "Proteinclass") +
theme_bw() +
theme(
axis.title.x = element_text(size = 15),
axis.title.y = element_text(size = 15),
axis.text.x  = element_text(size = 12),
axis.text.y  = element_text(size = 12)
)
lower_p <- OR_rank %>%
arrange(desc(odds_ratio)) %>%
mutate(ranking = row_number()) %>%
ggplot(aes(x=ranking, y = log2(odds_ratio), color = seroprof_titers)) +
geom_hline(yintercept = log2(1), linetype = "dashed") +
geom_point() +
scale_x_continuous(limits = c(1, NA)) +
#geom_text_repel(
#  aes(label = protein),
#  size = 3,
#  max.overlaps = 30,       # adjust depending on clutter
#  box.padding = 0.4,
#  point.padding = 0.2,
#  segment.color = "grey70"
#) +
labs(
y = "log2(Odds Ratio)",
x = "Ranking"
) +
scale_color_discrete(name = "Serological Profile") +
theme_bw() +
theme(
axis.title.x = element_text(size = 15),
axis.title.y = element_text(size = 15),
axis.text.x  = element_text(size = 12),
axis.text.y  = element_text(size = 12)
)
combined <- plot_grid(upper_p, lower_p, ncol = 1, align = "v", rel_heights = c(1, 1))
ggdraw(combined) +
draw_label("Enrichment of variability within epitopes ranked across proteins",
fontface = "bold", x = 0.5, y = 0.98, hjust = 0.5, size = 16) +
draw_label("Protein ranking", x = 0.5, y = 0.02, hjust = 0.5, size = 14)
