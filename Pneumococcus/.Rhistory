OR_rank %>%
group_by(proteinclass) %>%
summarize("OR_group" = log(odds_ratio)/n())
OR_rank %>%
group_by(proteinclass) %>%
summarize("OR_group" = exp(log(odds_ratio)/n()))
OR_rank %>%
group_by(proteinclass) %>%
summarize("OR_group" = exp(sum(log(odds_ratio))/n()))
OR_rank %>%
group_by(proteinclass) %>%
summarize(
logOR_mean = mean(log(odds_ratio), na.rm = TRUE),
logOR_sd   = sd(log(odds_ratio), na.rm = TRUE),
n          = sum(!is.na(odds_ratio)),
.groups = "drop"
) %>%
mutate(
SE_logOR = logOR_sd / sqrt(n),
CI_lower = exp(logOR_mean - 1.96 * SE_logOR),
CI_upper = exp(logOR_mean + 1.96 * SE_logOR),
OR_group = exp(logOR_mean)
) %>%
select(proteinclass, OR_group, CI_lower, CI_upper)
)
