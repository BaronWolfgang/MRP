`DiscoTope-3.0_calibrated_score`, Epigraph_score) %>%
distinct() %>%
column_to_rownames("resno") %>%
as.data.frame()
residues <- as.numeric(rownames(data_predictions_normalised_subset_wide))
colorbar_df <- get_residueindex_colors(residues, rev = FALSE)
annotation_col <- data.frame(NGL_Color = factor(residues))
annotation_colors <- list(
NGL_Color = setNames(colorbar_df$color, residues)
)
figure <- pheatmap(t(data_predictions_normalised_subset_wide),
cluster_rows = TRUE,
cluster_cols = FALSE,
main = paste0(pdb_entry, " chain ", chain_index, " (",proteinname,")"),
color = colorRampPalette(c("blue", "gray95", "red"))(50),
labels_col = "resno",
clustering_distance_rows = "correlation",
annotation_col = annotation_col,
annotation_colors = annotation_colors,
annotation_legend = FALSE,
annotation_names_col = FALSE
)
print(figure)
ggsave(filename = paste0("output/figures/heatmap/", pdb_entry, "_", chain_index, "_heatmap.png"),
plot = figure,
width = 14, height = 10, dpi = 300,
bg="white")
}
}
rainbow_ngl <- colorRampPalette(c("red", "orange", "yellow", "green", "blue"))
rainbow_ngl_reversed <- function(n) {
rev(rainbow_ngl(n))
}
get_residueindex_colors <- function(residues, rev = FALSE) {
n <- length(residues)
palette_colors <- colorRampPalette(c("red", "orange", "yellow", "green", "blue"))(n)
if (rev) palette_colors <- rev(palette_colors)
data.frame(resno = residues, color = palette_colors)
}
show_col(
get_residueindex_colors(
data_predictions_normalised_subset %>% filter(chain=="A") %>% pull(resno)
) %>%
pull(color),
labels = FALSE
)
