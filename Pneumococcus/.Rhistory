}, {
req(input$viewmode)  # ensure viewmode is selected
# 1. Normalize the selected column
selected_column <- input$viewmode
data <- data_reactive()
data$scaled <- scales::rescale(data[[selected_column]], to = c(0, 1))
if(input$viewmethod == "score") {
# 2. Bin into 21 bins
data$bin <- cut(data$scaled, breaks = num_bins, labels = FALSE)
# 3. Generate RWB color palette
rwb_palette <- colorRampPalette(c("blue", "white", "red"))(num_bins)
data$color <- rwb_palette[data$bin]
# 4. Build NGL selection strings
data$sele <- paste0("/0",data$resno,":",data$chain)
# 5. Group by color
color_groups <- data %>%
dplyr::group_by(color) %>%
dplyr::summarise(
sele = paste0(sele, collapse = " or "),
.groups = "drop"
)
for (i in seq_len(nrow(color_groups))) {
proxy <- proxy %>%
addSelection(input$type,
param = list(
name = paste0("sel", i),
sele = paste0(
"/0 AND (",color_groups$sele[i],")"
),
colorValue = color_groups$color[i]
)
)
}
}
else if(input$viewmethod == "threshold") {
req(!is.na(input$threshold_value))
top_residues <- data %>% filter(scaled >= input$threshold_value)
sele_string <- paste0(top_residues$resno, collapse = " or ")
proxy <- proxy %>%
addSelection(input$type,
param = list(
name = "threshold",
sele = sele_string,
colorScheme = "residueindex"
)
)
}
else if(input$viewmethod == "topn") {
req(!is.na(input$topn_value))
upper_quantile <- 1 - input$topn_value/100
quantile_threshold <- quantile(data$scaled, prob = upper_quantile, na.rm = TRUE)
top_residues <- data %>% filter(scaled >= quantile_threshold)
sele_string <- paste0(top_residues$resno, collapse = " or ")
proxy <- proxy %>%
addSelection(input$type,
param = list(
name = "topn",
sele = sele_string,
colorScheme = "residueindex"
)
)
}
})
observeEvent({
input$topn_value
input$threshold_value
}, {
req(input$viewmode)
selected_column <- input$viewmode
data <- data_reactive()
data$scaled <- scales::rescale(data[[selected_column]], to = c(0, 1))
proxy <- NGLVieweR_proxy("structure")
if (input$viewmethod == "topn") {
req(!is.na(input$topn_value))
quantile_threshold <- quantile(data$scaled, probs = 1 - input$topn_value / 100, na.rm = TRUE)
top_residues <- data %>% filter(scaled >= quantile_threshold)
sele_string <- paste0(top_residues$resno, ":", top_residues$chain, collapse = " or ")
proxy %>%
updateSelection("topn", sele = sele_string)
} else if (input$viewmethod == "threshold") {
req(!is.na(input$threshold_value))
top_residues <- data %>% filter(scaled >= input$threshold_value)
sele_string <- paste0(top_residues$resno, ":", top_residues$chain, collapse = " or ")
proxy %>%
updateSelection("threshold", sele = sele_string)
}
})
}
shinyApp(ui, server)
ui <- fluidPage(
uiOutput("dynamic_title"),
sidebarLayout(
sidebarPanel(
selectInput("pdb_file", "Select PDB",
choices = setNames(pdb_paths, tools::file_path_sans_ext(basename(pdb_paths)))
),
selectInput("type", "Type", c("ball+stick", "cartoon", "ribbon","surface")),
selectInput(
"viewmode","View mode",
colnames(pdb_annotation_df[sapply(pdb_annotation_df, is.numeric)])
),
selectInput("viewmethod", "View method", c("score", "topn", "threshold")),
conditionalPanel(
condition = "input.viewmethod == 'topn'",
sliderInput("topn_value", "Top n%",
min = 0, max= 100, value = 25, step = 5)
),
conditionalPanel(
condition = "input.viewmethod == 'threshold'",
sliderInput("threshold_value", "Threshold",
min = 0, max= 1, value = 0.5, step = 0.05)
),
actionButton("add", "Add"),
actionButton("remove", "Remove")
),
mainPanel(
NGLVieweROutput("structure")
)
)
)
server <- function(input, output) {
structure_id <- reactive({
req(input$pdb_file)
tools::file_path_sans_ext(basename(input$pdb_file))
})
data_reactive <- reactive({
req(structure_id())
pdb_annotation_df %>%
filter(structure == structure_id()) %>%
drop_na(chain, resno)
})
output$dynamic_title <- renderUI({
req(data_reactive())
data <- data_reactive()
protein_name <- unique(data$protein)
