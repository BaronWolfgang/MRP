pull(protein) %>%
unique()
upper_plot <- data_variability_with_seroprof %>%
select(seroprof_titers, proteinclass,protein,n_seq,seq_length) %>%
distinct() %>%
group_by(seroprof_titers) %>%
arrange(desc(n_seq)) %>%
mutate(
protein = factor(
protein,
levels = ordered_proteins
)
) %>%
ggplot(aes(x=protein)) +
geom_rect(
aes(
xmin = -Inf, xmax = Inf, ymin = -Inf, ymax = Inf, fill = seroprof_titers
),
inherit.aes = FALSE, alpha = 0.3,
data = data_variability_with_seroprof %>% distinct(seroprof_titers),
show.legend = FALSE  # Exclude facet-based color fill from the legend
) +
scale_fill_brewer(palette = "RdYlBu") +
new_scale_fill() +
geom_col(aes(y = n_seq, fill = proteinclass)) +
facet_grid(
~seroprof_titers,
scales = "free_x",
space = "free_x",
labeller = label_wrap_gen(width = 10)
) +
labs(y = "Number of sequences", x = NULL) +
scale_y_continuous(expand = expansion(mult = c(0, 0.05)), limits = c(0, NA)) +
theme_bw() +
theme(
strip.background = element_rect(fill = "white"),
strip.text = element_text(size = 16), # Adjust facet label text size
panel.background = element_rect(fill = "white", colour = "white"),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.spacing = unit(0, "lines"),
axis.line = element_line(),
axis.text.x = element_text(angle = 45, hjust = 1)
)
upper_plot
min_var_freq = 0.05
lower_plot <- data_variability_with_seroprof %>%
group_by(seroprof_titers,proteinclass, protein, seq_length) %>%
summarize(
nonzero_var_count = sum(var_freq > min_var_freq),
.groups = "drop"
) %>%
filter(!is.na(seq_length)) %>%
mutate(
normalized_var = nonzero_var_count / seq_length,
protein = factor(protein, levels = ordered_proteins)
) %>%
ggplot(aes(x = protein, y = normalized_var)) +
geom_rect(
aes(
xmin = -Inf, xmax = Inf, ymin = -Inf, ymax = Inf, fill = seroprof_titers
),
inherit.aes = FALSE, alpha = 0.3,
data = data_variability_with_seroprof %>% distinct(seroprof_titers),
show.legend = FALSE  # Exclude facet-based color fill from the legend
) +
scale_fill_brewer(palette = "RdYlBu") +
new_scale_fill() +
geom_col(aes(fill = proteinclass)) +
facet_grid(
~seroprof_titers,
scales = "free_x",
space = "free_x",
labeller = label_wrap_gen(width = 10)
) +
scale_y_continuous(expand = expansion(mult = c(0, 0.05)), limits = c(0, NA), breaks = seq(0, 1, by = 0.1) ) +
theme_bw() +
labs(y = "Normalized Variability", x = NULL) +
theme(
strip.background = element_rect(fill = "white"),
strip.text = element_text(size = 16), # Adjust facet label text size
panel.background = element_rect(fill = "white", colour = "white"),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.spacing = unit(0, "lines"),
axis.line = element_line(),
axis.text.x = element_text(angle = 45, hjust = 1)
)
lower_plot
plot_grid(
upper_plot +
theme(
axis.text.x = element_blank(),
axis.ticks.x = element_blank(),
plot.margin = margin(t = 5, r = 5, b = 1.5, l = 5)
)
,
lower_plot +
theme(
strip.text = element_blank(),
strip.background = element_blank(),
legend.position = "none",
plot.margin = margin(t = 0, r = 5, b = 5, l = 5)
),
ncol = 1,
align = "v",
axis = "rl",
rel_heights = c(1, 0.5)  # adjust height ratio as needed
)
map_namesclasspdb_aln <- data_namesclasspdb %>%
left_join(
tibble(
protein = unname(aln_protein_names),
matched_filename = names(aln_protein_names)
) %>%
filter(
!matched_filename %in% c(
"20 NgtS_old_group_1787.AA.aln.fas",
"28 MsrAB2_new_group_213.AA.aln.fas",
"28 MsrAB2_old_group_213.AA.aln.fas",
"28 MsrAB2_msrAB.AA.aln.fas")
)
)
map_namesclasspdb_aln
data_variability <- NULL
for (fasfile in map_namesclasspdb_aln$matched_filename) {
print(basename(fasfile))
protein_name <- if (grepl("^\\d+[ _]SP_\\d{4}", basename(fasfile))) {
sub(".*(SP_\\d{4}).*", "\\1", basename(fasfile))
} else {
sub("^\\d+[ _]([^_]+).*", "\\1", basename(fasfile))
}
print(protein_name)
tryCatch({
aligned_aa_seqs <- readAAStringSet(fasfile)
#print(aligned_aa_seqs)
data_variability_subset <- calculate_variability(aligned_aa_seqs)
data_variability_subset$protein <- protein_name
data_variability <- rbind(data_variability, data_variability_subset)
}, error = function(e) {
warning(paste("Skipping file due to error:", fasfile, "\nError message:", e$message))
})
}
data_variability <- data_variability %>%
left_join(map_namesclasspdb_aln, by = "protein") %>%
select(-matched_filename)
is.na(unique(map_namesclasspdb_aln$matched_filename)))
